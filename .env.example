# =================================
# SKARBIEC DZIECKA - ENVIRONMENT VARIABLES
# =================================
# Copy this file to .env.local and fill in your actual values

# ---------------------------------
# Supabase Configuration
# ---------------------------------
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------
# Ramp Network (Payment Processing)
# ---------------------------------
# Get API key from: https://ramp.network/
# Use demo mode for testing: https://app.demo.ramp.network
RAMP_API_KEY=your-ramp-api-key
NEXT_PUBLIC_RAMP_HOST_APP_NAME="Skarbiec Dziecka"

# ---------------------------------
# Blockchain Configuration
# ---------------------------------
# Base Sepolia Testnet (for development)
NEXT_PUBLIC_BASE_RPC_URL=https://base-sepolia.g.alchemy.com/v2/your-api-key
NEXT_PUBLIC_CHAIN_ID=84532

# For contract deployment (keep this secret!)
PRIVATE_KEY=your-wallet-private-key-here

# Base Mainnet (for production - uncomment when ready)
# NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/your-api-key
# NEXT_PUBLIC_CHAIN_ID=8453

# ---------------------------------
# Privy (Wallet Infrastructure)
# ---------------------------------
# Get from: https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-secret

# ---------------------------------
# Application Configuration
# ---------------------------------
NEXT_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------
# Optional Services
# ---------------------------------
# Sentry (Error Tracking)
# SENTRY_DSN=your-sentry-dsn

# Vercel (Deployment)
# VERCEL_URL=your-app.vercel.app
